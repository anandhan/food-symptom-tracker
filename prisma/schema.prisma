// Prisma schema for food and symptom tracking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table - supports both OAuth and credentials
model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  username      String?  @unique
  passwordHash  String?
  name          String?
  authProvider  String?
  googleId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailyEntries      DailyEntry[]
  weeklyReports     WeeklyReport[]
  analysisSnapshots AnalysisSnapshot[]
}

// Daily entry - one per user per date
model DailyEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals           Meal[]
  symptomRecord   SymptomRecord?
  uploadedImages  UploadedImage[]
  ocrExtractions  OcrExtraction[]

  @@unique([userId, date])
  @@index([userId, date])
}

// Uploaded images
model UploadedImage {
  id               String   @id @default(cuid())
  dailyEntryId     String
  storageKey       String
  mimeType         String?
  fileSize         Int?
  uploadedAt       DateTime @default(now())
  originalFilename String?

  dailyEntry     DailyEntry      @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  ocrExtractions OcrExtraction[]

  @@index([dailyEntryId])
}

// OCR extraction results from AI
model OcrExtraction {
  id              String   @id @default(cuid())
  imageId         String?
  dailyEntryId    String
  rawOcrText      String?
  extractedData   String   // JSON as string for SQLite
  extractedDate   DateTime?
  modelName       String
  modelVersion    String?
  confidenceScore Float?
  extractedAt     DateTime @default(now())

  image      UploadedImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  dailyEntry DailyEntry     @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  @@index([dailyEntryId])
}

// Meals within a day
model Meal {
  id           String   @id @default(cuid())
  dailyEntryId String
  mealType     String
  notes        String?
  createdAt    DateTime @default(now())

  dailyEntry    DailyEntry      @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  foodItems     FoodItem[]
  symptomEvents SymptomEvent[]

  @@index([dailyEntryId, mealType])
}

// Individual food items
model FoodItem {
  id         String   @id @default(cuid())
  mealId     String
  rawText    String
  brand      String?
  foodName   String?
  quantity   String?
  orderIndex Int      @default(0)
  isDrink    Boolean  @default(false)
  
  // Optional nutrition data
  calories   Int?
  carbs      Float?
  fat        Float?
  protein    Float?
  fiber      Float?
  sugar      Float?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  meal              Meal               @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodItemConcepts  FoodItemConcept[]

  @@index([mealId])
  @@index([rawText])
}

// Canonical food concepts for normalization
model FoodConcept {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String?
  aliases      String   // JSON array as string
  createdAt    DateTime @default(now())
  mergedIntoId String?
  isActive     Boolean  @default(true)

  mergedInto       FoodConcept?      @relation("MergedConcepts", fields: [mergedIntoId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  mergedFrom       FoodConcept[]     @relation("MergedConcepts")
  foodItemConcepts FoodItemConcept[]

  @@index([name])
}

// Many-to-many: food items to concepts
model FoodItemConcept {
  id            String   @id @default(cuid())
  foodItemId    String
  foodConceptId String
  confidence    Float?
  assignedBy    String
  assignedAt    DateTime @default(now())

  foodItem    FoodItem    @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  foodConcept FoodConcept @relation(fields: [foodConceptId], references: [id], onDelete: Cascade)

  @@unique([foodItemId, foodConceptId])
  @@index([foodItemId])
  @@index([foodConceptId])
}

// Symptom records - one per daily entry
model SymptomRecord {
  id            String   @id @default(cuid())
  dailyEntryId  String   @unique
  freeTextNotes String
  overallRating String?
  bloating      String?
  gas           String?
  crampsPain    String?
  diarrhea      Boolean?
  constipation  Boolean?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dailyEntry    DailyEntry     @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  symptomEvents SymptomEvent[]

  @@index([dailyEntryId])
  @@index([overallRating])
}

// Individual symptom events with timing
model SymptomEvent {
  id               String   @id @default(cuid())
  symptomRecordId  String
  mealId           String?
  description      String
  approximateTime  String?
  severity         String?
  symptomType      String
  createdAt        DateTime @default(now())

  symptomRecord SymptomRecord @relation(fields: [symptomRecordId], references: [id], onDelete: Cascade)
  meal          Meal?         @relation(fields: [mealId], references: [id], onDelete: SetNull)

  @@index([symptomRecordId])
  @@index([mealId])
}

// Weekly reports
model WeeklyReport {
  id               String   @id @default(cuid())
  userId           String
  startDate        DateTime
  endDate          DateTime
  generatedAt      DateTime @default(now())
  summaryText      String
  observedData     String   // JSON as string
  aiInterpretation String   // JSON as string
  modelName        String
  modelVersion     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

// Analysis snapshots for historical comparison
model AnalysisSnapshot {
  id             String   @id @default(cuid())
  userId         String
  analysisType   String
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  results        String   // JSON as string
  generatedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, analysisType, generatedAt])
}
